      "battle_phases": [
        {
          "completion_condition": "Opening outer hostiles are dead, #3 is destroyed, both medics are deployed and Steward begins his assignment.",
          "failure_effect_on_later_phases": "Lost income or an unfinished hostile queue invalidates later deployments and leaves an outer corridor open.",
          "goal": "Stop every opening hostile while establishing actual DP income.",
          "handoff_requirements": [
            "Melantha must complete upper duties before second 74.",
            "Midnight must kill his opening hostiles before second 80 and pass remaining #4 HP explicitly to Lava."
          ],
          "phase_id": "P1_OPENING",
          "responsibilities": [
            "Fang and Vanilla retain central traffic.",
            "Midnight and Melantha independently retain the outer opening.",
            "Lancet supplies temporary treatment; Gallus starts #1 clearance."
          ],
          "start_condition": "Stage begins with 10 DP and no deployed operators.",
          "survival_dependencies": [
            "Both vanguards must survive through the grants funding the opening.",
            "Midnight must survive without Lancet after second 40; this remains unverified."
          ]
        },
        {
          "completion_condition": "#1 and #4 are destroyed, the first civilian safely arrives, both permanent outer defenders are established and artillery is dead before Steward leaves coverage.",
          "failure_effect_on_later_phases": "A surviving artillery unit can destroy the terminal formation or the detained lower civilian; this phase cannot be rescued by crediting prior damage totals.",
          "goal": "Release the upper civilian and preserve sustained eastern artillery damage.",
          "handoff_requirements": [
            "Gallus must finish #1 before withdrawing.",
            "Lava must finish #4 before withdrawing.",
            "Artillery death must precede the fixed second-159 Steward retreat."
          ],
          "phase_id": "P2_PROTECTION_AND_ARTILLERY",
          "responsibilities": [
            "Gallus completes #1; Lava inherits #4 without assumed target priority.",
            "Beagle and Cardigan intercept later outer officers.",
            "Steward attacks the eastern artillery route while both medics maintain the support chain."
          ],
          "start_condition": "The medical pair and Steward are deployed.",
          "survival_dependencies": [
            "The revised spacing must prevent another cascading medical collapse.",
            "Ansel must sustain Steward despite also treating other damaged allies.",
            "Outer defenders receive no assumed healing or unsupported defensive talents."
          ]
        },
        {
          "completion_condition": "Midnight occupies [4,5], Durin occupies [5,5], and both central queues remain within available blocking capacity.",
          "failure_effect_on_later_phases": "An unsupported or late replacement reproduces central overflow and armored leaks.",
          "goal": "Provide immediate central arts before armored queues accumulate.",
          "handoff_requirements": [
            "Midnight's redeployment cooldown must have elapsed.",
            "No occupied-tile substitution or deferred automatic deployment is implied."
          ],
          "phase_id": "P3_CENTRAL_TRANSFER",
          "responsibilities": [
            "Execute the explicit Vanilla retreat, Midnight deployment and Durin deployment in order.",
            "Fang retains the upper corridor throughout.",
            "Durin supplies ordinary arts immediately while Midnight charges until second 193."
          ],
          "start_condition": "Lava has released [5,5] and Vanilla still owns lower central blocking.",
          "survival_dependencies": [
            "The medical chain must remain alive after artillery pressure.",
            "Actually available DP must fund both deployments without a refund assumption."
          ]
        },
        {
          "completion_condition": "#2 is destroyed and the second civilian safely reaches its objective.",
          "failure_effect_on_later_phases": "A surviving obstruction prevents complete protected-target acceptance even if every hostile is killed.",
          "goal": "Clear the lower western obstruction while keeping the delayed civilian safe.",
          "handoff_requirements": [
            "Gallus's second deployment uses the slot released by Steward.",
            "The second-300 retreat requires predicted #2 completion; otherwise the fixed plan has failed its clearance handoff."
          ],
          "phase_id": "P4_LOWER_RELEASE",
          "responsibilities": [
            "Gallus attacks #2 and any competing legal hostile targets with ordinary arts.",
            "Cardigan prevents officers from reaching western detention.",
            "All four hostile corridors remain staffed through the final second-211 spawn."
          ],
          "start_condition": "Artillery is dead, Cardigan holds the lower outer corridor and Gallus is redeployable.",
          "survival_dependencies": [
            "Cardigan must survive his complete queue without credited self-healing.",
            "The detained civilian must remain outside attacking officers' reach."
          ]
        },
        {
          "completion_condition": "remaining_life > 0, zero leaks, exhausted spawns, no active enemies, zero protected-target deaths and both expected protected targets safely arrived.",
          "failure_effect_on_later_phases": "Any leak, protected-target death or missing arrival rejects the plan.",
          "goal": "Finish the stage with complete objective acceptance.",
          "handoff_requirements": [
            "Gallus releases his slot only after the predicted clearance duty.",
            "Safe-arrival events must be checked independently of device destruction."
          ],
          "phase_id": "P5_CLEARANCE",
