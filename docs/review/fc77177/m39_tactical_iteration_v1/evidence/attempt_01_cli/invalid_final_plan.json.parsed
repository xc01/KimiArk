        }
      ],
      "mandatory_tactical_invariants": [
        {
          "id": "LEGAL_ROSTER",
          "requirement": "Every selected operator belongs to the supplied catalog, has rarity 1-3 and normal_mode true; no mode-specific reserves."
        },
        {
          "id": "LEGAL_DEPLOYMENT",
          "requirement": "Every deployment uses an integer [row,col], a cardinal direction, suitable supplied terrain, an empty tile and a free deployment slot. Never deploy on [[1,2],[6,2],[1,6],[6,6]]."
        },
        {
          "id": "EIGHT_SLOTS",
          "requirement": "At most eight operators are simultaneously deployed; listed retreats precede their same-frame replacements."
        },
        {
          "id": "REAL_ECONOMY",
          "requirement": "Use natural DP and actually earned vanguard grants. Do not credit refunds, unsupported talents or grants after death. Missing income is a failed survival dependency."
        },
        {
          "id": "NEUTRAL_PROTECTION",
          "requirement": "Ordinary operators neither attack nor block civilians. Civilian detention is caused by roadblocks; officer proximity within 1.2 remains dangerous."
        },
        {
          "id": "ARTILLERY_HANDOFF",
          "requirement": "Steward and the medical chain must survive long enough to kill artillery before eastern coverage ends. Saved damage totals are not transferable HP credits."
        },
        {
          "id": "CENTRAL_HANDOFF",
          "requirement": "Vanilla remains responsible until her explicit retreat; Midnight deploys next, then Durin. No conditional guard or automatic replacement is implied."
        },
        {
          "id": "OUTER_RETENTION",
          "requirement": "Beagle and Cardigan remain until all assigned officers are dead. Their survival is not inferred from central healing ranges."
        },
        {
          "id": "DEVICE_COMPLETION",
          "requirement": "Observe all four roadblock destructions and both safe arrivals independently. Predicted clearance times are not destruction events."
        },
        {
          "id": "ACCEPTANCE",
          "requirement": "remaining_life > 0, zero enemy leaks, exhausted spawns, no active enemies, zero protected-target deaths and exactly two protected targets safely reaching their objectives. Record operator deaths separately."
        }
      ],
