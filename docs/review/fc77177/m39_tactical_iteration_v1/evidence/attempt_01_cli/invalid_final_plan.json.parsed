      "formation_structure": {
        "artillery": "Steward owns the eastern vertical. Lava contributes at the lower eastern stop while also inheriting #4. No defender bait priority, compulsory caster target priority or splash damage is assumed.",
        "medical": "Ansel [5,6] DOWN and Hibiscus [2,5] UP mutually cover each other and both central blockers. Ansel covers Steward [2,7]; both medics cover Lava and later Durin [5,5]. This removes the former adjacent Ansel-Steward placement, but exact shell collateral safety is unverified.",
        "opening": "Fang and Vanilla share central damage. Midnight and Melantha intercept the outer opening independently. Lancet's contribution ends at second 40; no later healing or deployment refund from her is budgeted.",
        "protected_routes": "Melantha and Gallus clear the upper route. Midnight and Lava clear the lower eastern obstruction; redeployed Gallus clears the lower western obstruction. Beagle and Cardigan retain outer officers away from western detention.",
        "terminal": "Fang, Midnight, Beagle, Cardigan, both medics and Durin remain. Gallus temporarily occupies the eighth slot for western clearance; Steward later returns for upper central cleanup."
      },
      "formation_transitions": [
        {
          "frame": 1200,
          "transition": "Remove Lancet before her saved frame-1333 death. Opening outer survival thereafter must be achieved without crediting her healing."
        },
        {
          "frame": 2220,
          "transition": "Withdraw Melantha after the predicted opening upper clearance. An unfinished #3 at this point falsifies her handoff."
        },
        {
          "frame": 2400,
          "transition": "Withdraw Midnight after both opening lower hostiles are dead. Lava inherits any remaining #4 HP; no completed destruction is assumed."
        },
        {
          "frame": 3030,
          "transition": "Gallus leaves after predicted #1 destruction. Beagle arrives at frame 3180, before the first paired upper officer reaches the interception tile."
        },
        {
          "frame": 3600,
          "transition": "Cardigan establishes permanent lower outer interception before the paired lower officers arrive."
        },
        {
          "frame": 4350,
          "transition": "Lava leaves after her lower eastern artillery window and predicted #4 clearance. Her tile remains vacant until Durin arrives."
        },
        {
          "frame": 4590,
          "transition": "Retreat Vanilla first, deploy Midnight on [4,5], then deploy Durin on [5,5]. Midnight's second-80 retreat supplies more than 70 seconds of redeployment time."
        },
        {
          "frame": 4770,
          "transition": "Withdraw Steward after the eastern engagement window. Artillery must already be dead; this is not a conditional retreat instruction."
        },
        {
          "frame": 5130,
