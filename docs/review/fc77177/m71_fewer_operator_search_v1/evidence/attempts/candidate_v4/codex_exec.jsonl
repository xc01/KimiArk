{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python -B - <<'PY'\nimport json,sys\nfrom pathlib import Path\nsys.path.insert(0,'src')\nfrom arknights_planner.simulator.range import ApproximateRealRangeTransformer\nx=json.loads(Path('output/normal_low_star_facts_v1/normal_low_star_facts.json').read_text()); ops={r['operator_id']:r for r in x['operators']}\nT=ApproximateRealRangeTransformer()\nfor op,t,d in [('char_210_stward',[5,6],'DOWN'),('char_212_ansel',[5,5],'DOWN'),('char_120_hibisc',[5,3],'RIGHT')]:\n c=T.covered_tiles(origin=(t[1],t[0]),offsets=tuple(tuple(c) for c in ops[op]['range']['cells']),direction=d)\n print(json.dumps({'operator':op,'tile':t,'direction':d,'covered':sorted([y,x] for x,y in c)}))\n# Arithmetic only: chosen deploy/skill schedule, no battle execution.\nentries=[(0,-10,'Fang'),(91,-3,'Friston'),(571,-16,'Midnight'),(841,-15,'Melantha'),(1321,-17,'Ansel'),(1681,-17,'Hibiscus'),(2071,-18,'Steward'),(8100,9,'Steward living refund'),(8101,7,'Melantha living refund'),(10201,-18,'Steward west'),(10202,-15,'Melantha west')]\nentries += [(f,6,'Fang living grant') for f in range(570,10203,750)]\ndp=10; prev=0\nfor f,delta,label in sorted(entries,key=lambda x:x[0]):\n dp=min(99,dp+(f-prev)/30); dp=min(99,dp+delta); prev=f\n if delta<0 or 'refund' in label: print('DP',f,label,round(dp,4))\n if dp<0: raise ValueError('unfunded')\nfor name,deploy,initial,cost,dur,acts in [('Ansel',1321,10,35,25,[1890,3691,5492,7293]),('Hibiscus',1681,0,30,20,[2582,4083,5700,7201]),('Midnight',571,30,70,40,[1772,5073]),('Melantha',841,0,40,20,[2072,3873,5674,7475])]:\n ready=deploy+(cost-initial)*30\n for f in acts:\n  print('SP',name,f,'ready',f>=ready,'margin_frames',f-ready)\n  assert f>=ready\n  ready=f+(dur+cost)*30\nprint('one-time opening cost 96; total gross deployment 129; scheduled refunds 16; western redeploy gaps 2101 frames')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
