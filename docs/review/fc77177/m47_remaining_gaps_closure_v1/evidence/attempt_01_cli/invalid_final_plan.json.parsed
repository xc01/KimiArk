      "mandatory_tactical_invariants": [
        {
          "id": "LEGALITY",
          "requirement": "Every selected operator must match the supplied normal catalog, rarity 1-3 and normal_mode true. All deployment tiles are integer [row,col] with a cardinal direction."
        },
        {
          "id": "DEVICES",
          "requirement": "Never deploy on [[1,2],[6,2],[1,6],[6,6]], including after a device is destroyed."
        },
        {
          "id": "FIXED_EXECUTION",
          "requirement": "Execute only the listed fixed actions. Observable conditions are verification criteria, not waits, substitutions or conditional retreats."
        },
        {
          "id": "CIVILIANS",
          "requirement": "Ordinary operators neither attack nor block civilians. Both roadblock destructions and both safe arrivals must occur; absence of civilian death alone is insufficient."
        },
        {
          "id": "CLEARANCE",
          "requirement": "Midnight must actually damage and destroy #2 before his fixed retreat. Castle and Lava must actually destroy #1 while Plume maintains forward interception."
        },
        {
          "id": "SURVIVAL",
          "requirement": "Scheduled retreats require the operator to remain alive. No death refund or replacement action is assumed. GALLUS may die during Lava-centered splash without invalidating acceptance by itself."
        },
        {
          "id": "AIR_DAMAGE",
          "requirement": "Only ranged operators receive artillery damage credit. Steward's inspected highest-defense priority is a current-model dependency, not a verified client targeting guarantee."
        },
        {
          "id": "PROJECTILES",
          "requirement": "Withdrawal and artillery death do not erase already-created fixed-point shells. Account for the Melantha-centered opening shell and Lava-centered western splash."
        },
        {
          "id": "ARMOR_QUEUE",
          "requirement": "Cardigan must have free blocking capacity for #34. Steward must survive and clear earlier armor and runners; no unsupported universal client blockability is asserted."
        },
        {
          "id": "ACCEPTANCE",
          "requirement": "Require remaining_life > 0, zero enemy leaks, exhausted spawns, no active enemies, zero protected-target deaths and exactly two expected protected targets safely reaching their objectives."
        }
