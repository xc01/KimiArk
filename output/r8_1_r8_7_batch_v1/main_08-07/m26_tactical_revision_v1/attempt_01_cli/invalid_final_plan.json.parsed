  "revised_stage_understanding": {
    "clearance_geometry": "Midnight at [1,5] LEFT reaches [1,2] on his centerline. GALLUS² at [5,2] RIGHT reaches [6,2]. Lava [5,6] DOWN covers the patrol's lower eastern segment; Steward [2,7] UP covers its eastern vertical.",
    "current_model_rules": "Civilian neutrality, special roadblock restraint, officer civilian attacks within 1.2, protected-target life scoring and the positive-life WIN predicate supersede older UNKNOWN entries.",
    "gamedata_facts": "Four occupied roadblock tiles, legal terrain, operator source ranges, enemy statistics and source routes constrain the assignments.",
    "plan_label": "R8-7-M26-V1",
    "stage_alias": "R8-8-07",
    "stage_id": "main_08-07",
    "structural_revision": "Lower healing moves from [5,5] to [5,3]; patrol damage begins earlier and uses two casters together. The upper outer spawn gap supplies a temporary slot without abandoning a live engagement.",
    "unknown": "Exact client targeting, artillery lock selection, impact timing, active-roadblock ordinary navigation, device durability and realized clearance times remain unproven.",
    "validation_status": "UNSIMULATED_TACTICAL_HYPOTHESIS"
  },
