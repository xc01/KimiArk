      "formation_structure": {
        "artillery_phase": "Hibiscus supports Steward from [2,5]. Ansel at [5,3] covers Lava at [5,6], Vanilla and Plume. Melantha leaves during the upper outer spawn gap, allowing Lancet and both patrol casters to coexist within eight slots.",
        "final_lower": "Beagle [4,5], Plume [6,5], Ansel [5,3] and 12F [5,6] provide the corresponding lower duties.",
        "final_upper": "Cardigan [3,5], Midnight [1,5], Hibiscus [2,5] and Durin [2,6] provide blocking, outer interception, healing and arts clearance.",
        "opening": "Fang and Vanilla hold the central routes; Melantha and Plume intercept the outer routes. Lancet bridges upper survival while the physicians are purchased.",
        "protected_targets": "Ordinary operators neither attack nor block civilians. Eastern devices are damaged early; Midnight clears the upper western device, and GALLUS² clears the lower western device after artillery removal."
      },
      "formation_transitions": [
        {
          "frame": 330,
          "transition": "Vanilla replaces the prior expensive lower opening anchor; her attack skill becomes part of the raider survival responsibility."
        },
        {
          "frame": 810,
          "transition": "Lancet supplies the opening global heal and upper healing bridge."
        },
        {
          "frame": 1860,
          "transition": "Withdraw Melantha during the upper outer spawn gap. Her first raider and officer must already be dead and the upper eastern device destroyed."
        },
        {
          "frame": 2010,
          "transition": "Establish Steward while retaining Lancet."
        },
        {
          "frame": 2550,
          "transition": "Add Lava; the vacant upper outer slot permits eight deployed operators."
        },
        {
          "frame": 2850,
          "transition": "Withdraw Lancet and install Midnight before the next upper outer spawns; Midnight faces LEFT to reach the upper western device."
        },
        {
          "frame": 3450,
