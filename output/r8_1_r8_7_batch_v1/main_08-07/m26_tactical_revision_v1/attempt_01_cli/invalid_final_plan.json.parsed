        }
      ],
      "mandatory_tactical_invariants": [
        {
          "id": "LEGAL_OPERATORS",
          "requirement": "Every selected operator belongs to normal_low_star_catalog, has identity.rarity from 1 through 3, and qualification.normal_mode true. No mode-specific reserve unit is permitted."
        },
        {
          "id": "LEGAL_DEPLOYMENTS",
          "requirement": "Every deployment uses an integer [row,col], an allowed direction, a legal terrain tile and an empty slot. Never deploy on [[1,2],[6,2],[1,6],[6,6]]."
        },
        {
          "id": "OPENING_SURVIVAL",
          "requirement": "Both pioneers survive their raiders and remain available through their scheduled handoffs. A missing grant caused by injury or death is a survival failure, not a ledger correction."
        },
        {
          "id": "UPPER_OPENING_RELEASE",
          "requirement": "Before the frame-1860 retreat, the upper eastern roadblock and both initial upper outer hostiles are gone. Otherwise reject the fixed candidate."
        },
        {
          "id": "LOWER_EASTERN_RELEASE",
          "requirement": "The lower eastern roadblock is destroyed before it restrains the second civilian. Do not infer destruction merely from deployment duration."
        },
        {
          "id": "SHELL_SURVIVAL",
          "requirement": "Validate actual healing targets, heal times and HP before successive artillery impacts. No operator is assumed safe because of deployment order, baiting, average healing, or the previous failure's exact hit frames."
        },
        {
          "id": "PATROL_HANDOFF",
          "requirement": "The patrol is dead before frame 3840. If alive, reject this candidate rather than withdrawing its killers or silently delaying the conversion."
        },
        {
          "id": "WESTERN_CLEARANCE",
          "requirement": "Confirm upper western device destruction by Midnight and lower western device destruction before GALLUS² retreats. No roadblock HP, resistance or clearance duration is invented."
        },
        {
          "id": "NEUTRAL_PROTECTION",
          "requirement": "Never target or ordinarily block civilians. Account for officer attacks within 1.2 and any artillery exposure; both civilians must survive and reach safety."
        },
        {
          "id": "CAPACITY_AND_CLEARANCE",
          "requirement": "Retain all four final ground duties. Validate that central armor and paired raiders never exceed three-block capacity and that Plume completes each single-block handoff before another officer passes."
        },
        {
          "id": "ECONOMY",
          "requirement": "Use natural DP, Fang's supported cost reduction and actually produced pioneer skill grants. Assume no retreat refunds, kill income or unsupported economic talents."
        },
        {
          "id": "WIN",
          "requirement": "remaining_life > 0, enemies_leaked == 0, protected_target_deaths == 0, both protected targets arrived, spawn schedule exhausted and no active enemies."
        }
      ],
