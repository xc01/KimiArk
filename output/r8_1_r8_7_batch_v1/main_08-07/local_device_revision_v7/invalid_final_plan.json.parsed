      "mandatory_tactical_invariants": [
        {
          "rule": "Use only normal_low_star_catalog entries with identity.rarity 1-3 and qualification.normal_mode=true; exclude mode-specific reserves. Verified ordinary three-star catalog count: 17."
        },
        {
          "rule": "DEPLOY tiles are integer [row,col] with cardinal direction. Never deploy on [[1,2],[6,2],[1,6],[6,6]]."
        },
        {
          "rule": "Maximum eight deployed operators; require actual DP, legal free tile, available slot and completed cooldown at every deployment."
        },
        {
          "rule": "Require Fang income through frame 3570 and all four declared Vanilla activations. Missing income is a failed survival dependency and rejects downstream affordability."
        },
        {
          "rule": "Every blocker replacement requires its predecessor alive until retreat, immediate affordable replacement and safe reacquisition. No automatic substitutions or tactical action repair."
        },
        {
          "rule": "Lancet-2's supported global deployment heal and basic healing are credited. Any screening or healing allocation that preserves the pioneers remains unverified."
        },
        {
          "rule": "Credit no refunds, unsupported talents, probability effects, Cardigan self-healing, guaranteed splash, invented target ordering or civilian healing."
        },
        {
          "rule": "Manual skills require actual readiness; time-SP recovery pauses while active."
        },
        {
          "rule": "Patrol death must be observed before frame 3759. Preserve Steward until frame 4059; an unmet patrol gate rejects this candidate."
        },
        {
          "rule": "Durin's frame-5862 return requires her actual frame-3759 retreat and 70-second cooldown. Her clearance return requires the actual frame-9002 retreat."
        },
        {
          "rule": "Frame-9000 onward clearance actions require exhausted hostile spawns and zero living hostiles; neutral civilians may remain active."
        },
        {
          "rule": "Retreat Hibiscus and Ansel before occupying their clearance tiles; retain outer blockers until civilian safety and completion are established."
        },
        {
          "rule": "Ordinary operators neither attack nor block neutral civilians. Officers may attack civilians within 1.2; require zero civilian deaths."
        },
        {
          "rule": "An absent Lancet-2 retreat is optional; any other unmet fixed-action gate rejects the candidate."
        },
        {
          "rule": "WIN requires remaining_life>0, zero leaks, exhausted spawns and no active enemies. Acceptance additionally requires two civilian arrivals, zero civilian deaths and completion within 600 seconds."
        }
      ],
