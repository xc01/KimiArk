      "changed_conflicting_assumptions": [
        {
          "change": "Replace the early GALLUS²-to-Lava handoff with GALLUS²-to-Durin; remove Lava's frame-2862 activation.",
          "reason": "Resolve the recorded SP conflict without relying on the checker attributing an earlier activation to the correct deployment. Durin supplies ordinary single-target Arts without a manual-skill dependency; Lava has one deployment."
        },
        {
          "change": "Retreat patrol Durin at frame 3759 and redeploy her centrally at frame 5862.",
          "reason": "Respect her 70-second cooldown. Melantha and Hibiscus carry the first upper armored encounter before Durin returns."
        },
        {
          "change": "Retreat Hibiscus at frame 9004 and Ansel at frame 9005 before clearance deployments.",
          "reason": "Exactly resolve occupied tiles [2,5] and [5,3]. These retreats require hostile clearance."
        },
        {
          "change": "Treat every opening income and replacement gate as a survival obligation.",
          "reason": "V5's missing income followed combat losses. Conditional affordability cannot establish that the operators survive to generate it."
        }
      ],
