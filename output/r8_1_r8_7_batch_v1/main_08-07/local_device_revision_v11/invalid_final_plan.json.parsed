      "mandatory_tactical_invariants": [
        {
          "rule": "At most eight deployed operators; replacements retire predecessors first."
        },
        {
          "rule": "Never deploy on [[1,2],[6,2],[1,6],[6,6]]."
        },
        {
          "rule": "Do not credit unsupported talents, splash geometry, Spot healing, refunds, target commands or damage resistance."
        },
        {
          "rule": "Never attack or block civilians with ordinary operators; civilian death deducts objective life."
        },
        {
          "rule": "Missed income is a survival or handoff failure, not an arithmetic correction."
        },
        {
          "rule": "Conditional groups require observed prerequisites, actual DP, vacancies, cooldown and readiness; defer the dependent group together."
        },
        {
          "rule": "Eastern patrol withdrawal does not establish death. Western attackers remain responsible until observed death."
        },
        {
          "rule": "No late-wave or clearance transfer may silently discard a living patrol."
        },
